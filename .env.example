# Copy this file to .env and fill in the values from the Supabase project's dashboard.
# .env is git-ignored. On Render, enter the same three settings in the service's dashboard.
# npm start and npm run seed:supabase read them. npm run dev, npm run seed and the tests never do.

# The session pooler connection string (Connect > Session pooler), with the database password in it.
DATABASE_URL=
# The project's address, like https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# The publishable key (Project Settings > API Keys), which starts with sb_publishable_
SUPABASE_PUBLISHABLE_KEY=
